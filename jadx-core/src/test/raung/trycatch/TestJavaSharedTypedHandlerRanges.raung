.version 49.0
.class public trycatch/TestJavaSharedTypedHandlerRanges
.super java/lang/Object

.method public static test(Z)V
    .max stack 1
    .max locals 2

    iload 0
    ifeq :second
  :first_start
    invokestatic trycatch/TestJavaSharedTypedHandlerRanges first ()V
  :first_end
    .catch java/lang/IllegalArgumentException :first_start .. :first_end goto :handler
    goto :done

  :second
  :second_start
    invokestatic trycatch/TestJavaSharedTypedHandlerRanges second ()V
  :second_end
    .catch java/lang/IllegalStateException :second_start .. :second_end goto :handler

  :done
    return

  :handler
    astore 1
    return
.end method

