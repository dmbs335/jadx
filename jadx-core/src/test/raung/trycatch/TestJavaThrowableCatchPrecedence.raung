.version 49.0
.class public trycatch/TestJavaThrowableCatchPrecedence
.super java/lang/Object

.method public static test()V
    .max stack 1
    .max locals 1

  :try_start
    invokestatic trycatch/TestJavaThrowableCatchPrecedence first ()V
  :try_end
    .catch java/lang/Throwable :try_start .. :try_end goto :throwable_handler
    .catch java/lang/IllegalStateException :try_start .. :try_end goto :typed_handler
    return

  :throwable_handler
    astore 0
    invokestatic trycatch/TestJavaThrowableCatchPrecedence handled ()V
    return

  :typed_handler
    astore 0
    invokestatic trycatch/TestJavaThrowableCatchPrecedence wrong ()V
    return
.end method

.method private static first()V
    .max stack 0
    .max locals 0
    return
.end method

.method private static handled()V
    .max stack 0
    .max locals 0
    return
.end method

.method private static wrong()V
    .max stack 0
    .max locals 0
    return
.end method
